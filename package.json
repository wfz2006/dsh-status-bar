{
  "name": "dsh-glass", "version": "0.1.0", "private": true, "type": "module", "license": "MIT",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "node scripts/build-region-capture.mjs && pnpm --filter @glass/desktop dev",
    "build": "node scripts/build-region-capture.mjs && pnpm --filter @glass/desktop build",
    "start": "pnpm --filter @glass/desktop start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:preferences": "node scripts/preferences-acceptance.mjs",
    "test:approval-layout": "node scripts/approval-layout.mjs",
    "test:motion": "node scripts/motion-acceptance.mjs",
    "test:experience": "node scripts/experience-acceptance.mjs",
    "test:performance": "node scripts/performance-acceptance.mjs",
    "test:process-latency": "node scripts/process-latency-acceptance.mjs",
    "test:native-redesign": "node scripts/native-redesign.mjs",
    "test:liquid": "node scripts/liquid-acceptance.mjs",
    "test:live": "node scripts/live-dsh-integration.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1", "eslint": "9.39.1", "typescript-eslint": "8.48.0",
    "typescript": "5.9.3", "vitest": "5.0.5", "@types/node": "24.10.0",
    "@playwright/test": "1.56.1", "@types/ws": "8.18.1", "ws": "8.18.3", "vite": "8.3.4"
  }
}
